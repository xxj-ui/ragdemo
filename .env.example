# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交；本文件只放占位值，不要写真实密码。

# ---------- PostgreSQL（pgvector） ----------
POSTGRES_DB=zhiwen
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me

# ---------- MinIO ----------
# 控制台登录用；MINIO_ROOT_PASSWORD 至少 8 位
MINIO_ROOT_USER=zhiwen-admin
MINIO_ROOT_PASSWORD=change-me-8chars

# minio-init 建桶参数
MINIO_BUCKET=zhiwen
MINIO_BUCKET_QUOTA=10GiB

# ---------- 后端环境变量（compose 不使用，列在这里方便对照） ----------
# RAG_DB_DSN=postgresql://root:<POSTGRES_PASSWORD>@127.0.0.1:54328/zhiwen
# 将来接入 MinIO 后才会用到：
# RAG_S3_ENDPOINT=http://127.0.0.1:9100
# RAG_S3_BUCKET=zhiwen
# RAG_S3_ACCESS_KEY=
# RAG_S3_SECRET_KEY=
# RAG_S3_SECURE=false
# 扫描件 OCR（无文字层的 PDF 页按页识别；0 关闭）
# RAG_OCR=1
# RAG_OCR_DPI=120
# RAG_OCR_MIN_CHARS=10
# RAG_OCR_MAX_PAGES=0
